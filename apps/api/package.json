{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/local.ts",
    "generate:auth-schema": "better-auth generate --config src/lib/auth/index.ts --output ../../packages/db/src/auth-schema.ts --yes",
    "check:types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@hono/zod-validator": "0.9.1",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "hono": "4.13.5",
    "openai": "7.15.0",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@better-auth/cli": "npm:auth@1.7.4",
    "@electric-sql/pglite": "0.5.8",
    "@hono/node-server": "2.1.1",
    "tsx": "4.23.13"
  }
}
