# The API's local secrets (ID68). Copy this file to `.env` beside it, fill the values,
# and `pnpm dev` loads it: the dev script passes `--env-file-if-exists=.env` to Node,
# so nothing else reads it and `env.ts` stays the one reader of the environment.
# `.env` is ignored by git; this example is the only one committed. The schema generator
# (`pnpm --filter @app/api generate:auth-schema`) loads it from this directory too, and
# needs it: the configuration it reads refuses to load without the values.
#
# Three provider apps registered for localhost (D4, ID61), each with its redirect URI
#   http://localhost:4200/api/auth/callback/<provider>
# exactly: the dev server's port, through its proxy to the API. A different port is a
# `redirect_uri_mismatch` at the provider's door. All six values are required on
# localhost and the API refuses to start without them, naming the missing one.
#
# Google: an OAuth client app, callback `.../callback/google`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: an app in Microsoft Entra ID registered for "accounts in any
# organizational directory and personal Microsoft accounts", which is what the
# `common` tenant the API signs in through admits; callback `.../callback/microsoft`.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# LinkedIn: an app with the "Sign In with LinkedIn using OpenID Connect" product
# activated (scopes openid, profile, email; nothing more, D10); callback
# `.../callback/linkedin`.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# What the authentication library signs its session cookies with (ID71). The one value
# here whose blank is already filled, and deliberately: unlike a client secret it does
# have a sensible throwaway, exactly as the database password `local_dev_only` is
# committed in `docker-compose.yml` (ID103). Copy it as it stands.
#
# A per-developer local value would protect nothing — the local database holds no real
# person, and the secret that matters is the one in Secrets Manager — and it would cost
# something real: `e2e/support/session.ts` signs its cookies with this same literal, so
# a value of your own makes `pnpm test:e2e` go red on isolation and deletion with a
# failure that reads like a session bug and is a configuration one.
#
# The deployed function's is a different value, held in Secrets Manager and reaching the
# function through the template. Changing either invalidates every session signed with
# the old one.
BETTER_AUTH_SECRET=local_dev_only_not_a_real_secret_00000000

# The AI boundary (ID114, ID127). Nothing here needs filling in, and that is the
# point: every environment of this slot calls the mock mounted in this same
# application, so a fresh clone runs the whole intake with no key and no account
# registered anywhere. The four lines are commented out and show their defaults.
#
# AI_BASE_URL is the only switch there is. The product speaks one wire protocol
# and branches on no provider (D9), so pointing it at OpenAI, at Azure, at a
# self-hosted vLLM or at Anthropic's OpenAI-compatible endpoint is the same
# integration. It ends at the `/v1`-equivalent, because the client appends
# `/chat/completions` itself. Its default follows PORT, since the mock is served
# by this very process.
# AI_BASE_URL=http://localhost:3000/mock/v1
#
# AI_API_KEY is a committed throwaway, as the database password and the auth
# secret are: the mock does not read it. The first real key is a Secrets Manager
# entry in the slot that switches a provider on.
# AI_API_KEY=local_dev_only_the_mock_ignores_it
#
# AI_MODEL is a name and nothing more while the mock answers, which does not
# dispatch on it.
# AI_MODEL=mock-model
#
# AI_MOCK_PACE times the mock's answers the way a model would, so the reading
# screen can be watched behaving as it will in production, and so a slow answer
# can be provoked on purpose. Four settings: tokens per second (0 means the whole
# answer at once), time to first token in milliseconds, tokens per chunk, and
# jitter as a fraction. The same spelling works per request in the
# X-Jobapp-Mock-Pace header, which a real provider ignores. The suite runs them
# all at zero.
# AI_MOCK_PACE=tps=40;ttft=400;chunk=3;jitter=0.15
