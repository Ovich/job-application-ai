{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "itemId": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "set"
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "description": "the field's name, as the item shows it"
              },
              "value": {
                "description": "the new value, or null to empty the field",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "op",
              "field",
              "value"
            ],
            "additionalProperties": false,
            "description": "Set one field of the item: its title, subtitle, dates, or a field of its kind."
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "replace_line"
              },
              "lineId": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "lineId",
              "text"
            ],
            "additionalProperties": false,
            "description": "Replace the text of one line of the item."
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "add_line"
              },
              "position": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "0 is first; later lines move down"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "position",
              "text"
            ],
            "additionalProperties": false,
            "description": "Add a line to the item at a position."
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "remove_line"
              },
              "lineId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "lineId"
            ],
            "additionalProperties": false,
            "description": "Remove one line of the item."
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "remove_child"
              },
              "childId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "childId"
            ],
            "additionalProperties": false,
            "description": "Remove one item that hangs under this item."
          }
        ]
      }
    }
  },
  "required": [
    "itemId",
    "operations"
  ],
  "additionalProperties": false
}
