{
  "Description": "The hosted zone for job-application.app, the alert topic and the spend alarm.",
  "Resources": {
    "ZoneA5DE4B68": {
      "Type": "AWS::Route53::HostedZone",
      "Properties": {
        "HostedZoneConfig": {
          "Comment": "job-application.app. Name servers set at Spaceship, the registrar."
        },
        "Name": "job-application.app."
      },
      "Metadata": {
        "aws:cdk:path": "Dns/Zone/Resource"
      }
    },
    "Alerts91F83244": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "DisplayName": "job-application.app alerts"
      },
      "Metadata": {
        "aws:cdk:path": "Dns/Alerts/Resource"
      }
    },
    "Alertstigoes44gmailcomE68ABA00": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "Endpoint": "tigoes44@gmail.com",
        "Protocol": "email",
        "TopicArn": {
          "Ref": "Alerts91F83244"
        }
      },
      "Metadata": {
        "aws:cdk:path": "Dns/Alerts/tigoes44@gmail.com/Resource"
      }
    },
    "AlertsPolicy425C338D": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "SNS:Publish",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "917993967998"
                }
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "budgets.amazonaws.com"
              },
              "Resource": {
                "Ref": "Alerts91F83244"
              },
              "Sid": "0"
            }
          ],
          "Version": "2012-10-17"
        },
        "Topics": [
          {
            "Ref": "Alerts91F83244"
          }
        ]
      },
      "Metadata": {
        "aws:cdk:path": "Dns/Alerts/Policy/Resource"
      }
    },
    "MonthlySpend": {
      "Type": "AWS::Budgets::Budget",
      "Properties": {
        "Budget": {
          "BudgetLimit": {
            "Amount": 20,
            "Unit": "USD"
          },
          "BudgetName": "monthly-spend",
          "BudgetType": "COST",
          "TimeUnit": "MONTHLY"
        },
        "NotificationsWithSubscribers": [
          {
            "Notification": {
              "ComparisonOperator": "GREATER_THAN",
              "NotificationType": "FORECASTED",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "Address": {
                  "Ref": "Alerts91F83244"
                },
                "SubscriptionType": "SNS"
              }
            ]
          },
          {
            "Notification": {
              "ComparisonOperator": "GREATER_THAN",
              "NotificationType": "ACTUAL",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "Address": {
                  "Ref": "Alerts91F83244"
                },
                "SubscriptionType": "SNS"
              }
            ]
          }
        ]
      },
      "Metadata": {
        "aws:cdk:path": "Dns/MonthlySpend"
      }
    },
    "CDKMetadata": {
      "Type": "AWS::CDK::Metadata",
      "Properties": {
        "Analytics": "v2:deflate64:H4sIAAAAAAAA/1WLuw6CQBBFv8V+GQk+Yi2NnUSsbAz7wAzgLmFmJWaz/26ARGN177mPDLL9AdJVNVKidJt0KCGUXKlWVCPdw+A8m90GQuFlh+rkiI2+OWtEXtsfRUGWIFxdj2pqFlN6SWrAntHZKf3jeVK4DtX7+1gwCun1wzBBXtvjbOM0OXvuPUdhnTbQ0PqVbSFLIV01hJgM3jI+DVwW/QC/CxhQ2QAAAA=="
      },
      "Metadata": {
        "aws:cdk:path": "Dns/CDKMetadata/Default"
      }
    }
  },
  "Outputs": {
    "NameServers": {
      "Description": "Set these four at the registrar. Nothing validates a certificate until they propagate.",
      "Value": {
        "Fn::Join": [
          ", ",
          {
            "Fn::GetAtt": ["ZoneA5DE4B68", "NameServers"]
          }
        ]
      }
    },
    "AlertTopicArn": {
      "Value": {
        "Ref": "Alerts91F83244"
      }
    }
  },
  "Parameters": {
    "BootstrapVersion": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
    }
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  ["1", "2", "3", "4", "5"],
                  {
                    "Ref": "BootstrapVersion"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
        }
      ]
    }
  }
}
