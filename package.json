{
  "name": "job-application-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "check": "pnpm run check:lint && pnpm run check:types && pnpm run test",
    "check:lint": "biome check .",
    "check:types": "tsc -p tsconfig.json --noEmit && pnpm -r run check:types",
    "test": "vitest run --passWithNoTests",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
